<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lab.emp.mapper.EmpMapper">

    <!-- 员工 + 部门名称的结果映射 -->
    <resultMap id="EmpWithDeptMap" type="com.lab.emp.entity.Emp">
        <id column="emp_id" property="empId"/>
        <result column="emp_name" property="empName"/>
        <result column="gender" property="gender"/>
        <result column="dept_id" property="deptId"/>
        <result column="dept_name" property="deptName"/>
        <result column="post" property="post"/>
        <result column="salary" property="salary"/>
        <result column="hire_date" property="hireDate"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <!-- 公共查询列，避免 select * 带来的隐式耦合 -->
    <sql id="BaseColumns">
        e.emp_id, e.emp_name, e.gender, e.dept_id, e.post, e.salary,
        e.hire_date, e.status, e.create_time, e.update_time, e.deleted, d.dept_name
    </sql>

    <!-- 按主键查询（带部门名称），用于详情与修改回显 -->
    <select id="selectByIdWithDept" resultMap="EmpWithDeptMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM emp e
        LEFT JOIN dept d ON e.dept_id = d.dept_id
        WHERE e.deleted = 0 AND e.emp_id = #{empId}
    </select>

    <!-- 部门维度统计：人数 / 平均薪资 / 最高薪资 -->
    <select id="statByDept" resultType="com.lab.emp.dto.DeptStatDTO">
        SELECT d.dept_id   AS deptId,
               d.dept_name AS deptName,
               COUNT(e.emp_id)                    AS empCount,
               IFNULL(ROUND(AVG(e.salary), 2), 0) AS avgSalary,
               IFNULL(MAX(e.salary), 0)           AS maxSalary
        FROM dept d
        LEFT JOIN emp e ON e.dept_id = d.dept_id AND e.deleted = 0
        GROUP BY d.dept_id, d.dept_name
        ORDER BY d.dept_id
    </select>

</mapper>